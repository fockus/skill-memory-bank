{
  "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "~/.claude/hooks/block-dangerous.sh # [memory-bank-skill]"
        }
      ]
    },
    {
      "matcher": "Write|Edit",
      "hooks": [
        {
          "type": "command",
          "command": "~/.claude/skills/memory-bank/hooks/mb-protected-paths-guard.sh # [memory-bank-skill]"
        },
        {
          "type": "command",
          "command": "~/.claude/skills/memory-bank/hooks/mb-ears-pre-write.sh # [memory-bank-skill]"
        }
      ]
    },
    {
      "matcher": "Task|Agent",
      "hooks": [
        {
          "type": "command",
          "command": "~/.claude/skills/memory-bank/hooks/mb-context-slim-pre-agent.sh # [memory-bank-skill]"
        },
        {
          "type": "command",
          "command": "~/.claude/skills/memory-bank/hooks/mb-sprint-context-guard.sh # [memory-bank-skill]"
        }
      ]
    },
    {
      "matcher": "Grep|Bash",
      "hooks": [
        {
          "type": "command",
          "command": "~/.claude/hooks/mb-graph-nudge.sh # [memory-bank-skill]"
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Write",
      "hooks": [
        {
          "type": "command",
          "command": "~/.claude/hooks/file-change-log.sh # [memory-bank-skill]"
        },
        {
          "type": "command",
          "command": "~/.claude/skills/memory-bank/hooks/mb-plan-sync-post-write.sh # [memory-bank-skill]"
        }
      ]
    },
    {
      "matcher": "Edit",
      "hooks": [
        {
          "type": "command",
          "command": "~/.claude/hooks/file-change-log.sh # [memory-bank-skill]"
        }
      ]
    }
  ],
  "Notification": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "osascript -e 'display notification \"Claude Code needs attention\" with title \"Claude Code\"' 2>/dev/null; true # [memory-bank-skill]"
        }
      ]
    }
  ],
  "PreCompact": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "~/.claude/hooks/mb-pre-compact.sh # [memory-bank-skill]"
        },
        {
          "type": "command",
          "command": "echo '[memory-bank-skill] Keep in the summary: the active plan or spec path and the current stage or task number; checklist items finished or added this session; decisions the user confirmed (with AGR ids if recorded); .memory-bank files changed but not yet actualized. CLAUDE.md is reloaded after compaction, so do not restate it. Write the summary only; do not call tools.'"
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "MB_AGENT=claude-code ~/.claude/skills/memory-bank/hooks/mb-flow-closure-guard.sh # [memory-bank-skill]"
        },
        {
          "type": "command",
          "command": "MB_AGENT=claude-code ~/.claude/skills/memory-bank/hooks/mb-drive-resume-gate.sh # [memory-bank-skill]",
          "timeout": 15
        },
        {
          "type": "command",
          "command": "MB_AGENT=claude-code ~/.claude/skills/memory-bank/hooks/mb-core-cap-guard.sh # [memory-bank-skill]",
          "timeout": 20
        },
        {
          "type": "command",
          "command": "~/.claude/hooks/mb-session-turn.sh # [memory-bank-skill]"
        },
        {
          "type": "command",
          "command": "if [ -d .memory-bank ] && [ -f ~/.claude/skills/memory-bank/scripts/mb-freshness.sh ]; then bash ~/.claude/skills/memory-bank/scripts/mb-freshness.sh --stop-nudge 2>/dev/null || true; fi # [memory-bank-skill]"
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "~/.claude/hooks/mb-semantic-recall.sh # [memory-bank-skill]"
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "matcher": "compact",
      "hooks": [
        {
          "type": "command",
          "command": "~/.claude/hooks/mb-graph-nudge.sh --reset # [memory-bank-skill]"
        }
      ]
    },
    {
      "hooks": [
        {
          "type": "command",
          "command": "~/.claude/hooks/mb-session-start.sh # [memory-bank-skill]"
        },
        {
          "type": "command",
          "command": "~/.claude/hooks/mb-session-catchup.sh # [memory-bank-skill]"
        },
        {
          "type": "command",
          "command": "~/.claude/skills/memory-bank/hooks/mb-update-notify.sh # [memory-bank-skill]"
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "~/.claude/hooks/mb-session-end.sh # [memory-bank-skill]",
          "timeout": 240
        },
        {
          "type": "command",
          "command": "~/.claude/hooks/session-end-autosave.sh # [memory-bank-skill]"
        }
      ]
    }
  ]
}
