[run]
source = .

# Most of this skill's Python is a library behind a shell CLI: `mb-*.sh` runs
# `python3 scripts/mb_*.py`, and the tests that exercise those modules are bats
# files (or pytest files that shell out). Coverage measures the pytest process
# only, so it reported the modules below at 0% — "untested" about code that
# every CI run executes. That miscount is what pushed the total under the 85%
# gate, not a loss of tests.
#
# This list is NOT a place to hide untested code: every entry must be mapped to
# its owning test in tests/pytest/test_coverage_omit_is_honest.py, which fails
# when an omitted module has no test that reaches it. Adding a line here without
# adding it there turns the suite red.
omit =
    memory_bank_skill/__main__.py
    scripts/mb-code-context.py
    scripts/mb-context-slim.py
    scripts/mb-graph-query.py
    scripts/mb-scenario-extract.py
    scripts/mb-sdd-layers-render.py
    scripts/mb-settings-ensure-timeout.py
    scripts/mb-statusline.py
    scripts/mb_backlog_state_engine.py
    scripts/mb_brief_candidate.py
    scripts/mb_code_context_core.py
    scripts/mb_contract_gate.py
    scripts/mb_contract_registry.py
    scripts/mb_graph_query_render.py
    scripts/mb_pipeline_validate_blocks.py
    scripts/mb_pipeline_validate_core.py
    scripts/mb_quality_dod.py
    scripts/mb_roadmap_group.py
    scripts/mb_roadmap_plans.py
    scripts/mb_rules_resolve.py
    scripts/mb_sdd_judge_journal.py
    scripts/mb_spec_validate_graph.py
    scripts/mb_spec_validate_layers.py
    scripts/mb_spec_validate_scope_eval.py
    scripts/mb_spec_validate_tasks.py
    scripts/mb_spec_validate_v2.py
    scripts/mb_work_plan_wrapper.py

[report]
show_missing = True
skip_empty = True
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
